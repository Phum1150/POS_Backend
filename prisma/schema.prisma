// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProductType {
  DRINK
  SWEET
}

model Product {
  id                   Int                   @id @default(autoincrement())
  name                 String
  price                Decimal
  type                 ProductType
  isActive             Boolean               @default(true)
  cartItems            CartItem[]
  checkoutHistoryItems CheckoutHistoryItem[]
}

model Cart {
  id        Int        @id @default(autoincrement())
  name      String
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}

model CheckoutHistory {
  id        Int                   @id @default(autoincrement())
  promotion String?
  netPrice  Decimal
  createdAt DateTime              @default(now())
  items     CheckoutHistoryItem[]
}

model CheckoutHistoryItem {
  id                Int             @id @default(autoincrement())
  checkoutHistoryId Int
  checkoutHistory   CheckoutHistory @relation(fields: [checkoutHistoryId], references: [id])
  productId         Int?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName       String
  price             Decimal
  quantity          Int
}
